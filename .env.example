# Required for AI-generated ingredient lists for any product type.
# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required for verified competitor listings, Place IDs, and business details.
# Enable Places API (New) in Google Cloud and keep this key server-side.
GOOGLE_MAPS_API_KEY=

# Optional review fallback. Keeps review bubbles working when Google Places
# does not return review text. Create a private key at https://serpapi.com/.
SERPAPI_API_KEY=

# Identifies MulaiUsaha when using the public OpenStreetMap geocoder.
APP_CONTACT_URL=http://localhost:5173
PORT=5173

# Optional. Defaults to data/mulaiusaha.sqlite.
PRICE_DATABASE_PATH=

# --- Masuk dengan Google -----------------------------------------------------
# Client ID OAuth dari Google Cloud Console (Credentials -> OAuth client ID ->
# Web application). Bukan rahasia: nilainya memang tampil di halaman. Client
# Secret TIDAK diperlukan untuk alur ini, jangan disimpan di sini.
# Authorized JavaScript origins: http://localhost:5173 (+ domain produksi).
GOOGLE_CLIENT_ID

# Kunci untuk menandatangani cookie sesi. Minimal 32 karakter, acak, rahasia.
# Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Menggantinya akan mengeluarkan semua orang yang sedang masuk.
SESSION_SECRET

# --- Penyimpanan pengguna (Supabase) -----------------------------------------
# service_role key MELEWATI Row Level Security. Server-side saja, jangan pernah
# masuk ke src/. Jalankan SQL pembuatan tabel di komentar server/userStore.js.
SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY

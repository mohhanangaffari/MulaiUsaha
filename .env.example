# Setiap variabel di sini benar-benar dibaca kode. Daftarnya dicocokkan dengan
# hasil pencarian `process.env.*` di server/ pada 2026-08-25.

# --- Wajib: tanpa ini fitur intinya mati -------------------------------------

# Konsep usaha dan daftar bahan dari AI (server/aiService.js).
# Tanpa ini: langkah 3 dan 4 tidak menghasilkan apa pun.
GEMINI_API_KEY=

# Google Places + Geocoding: pesaing, detail tempat, pencarian lokasi.
# Aktifkan "Places API (New)" di Google Cloud. Server-side saja.
# Tanpa ini: langkah 2 kosong.
GOOGLE_MAPS_API_KEY=

# Ulasan pesaing dan pencarian toko pemasok lokal (server/serpApiService.js).
# Tanpa ini: tab "Lokal" di langkah 4 tidak menemukan toko.
SERPAPI_API_KEY=

# Menyebut identitas MulaiUsaha ke geocoder publik OpenStreetMap. Isi dengan URL
# atau email kontak. Tanpa ini permintaan bisa dibatasi oleh mereka.
APP_CONTACT_URL=

# --- Opsional ----------------------------------------------------------------

# Kunci SerpApi cadangan. Dipakai bergantian saat kuota kunci utama habis.
SERPAPI_KEY_2=
SERPAPI_KEY_3=
SERPAPI_KEY_4=
SERPAPI_KEY_5=

# Port server lokal. Default 5173. JANGAN diisi di Vercel — platform yang
# menentukannya sendiri, dan mengisinya bisa menggagalkan deploy.
PORT=

# --- Masuk dengan Google -----------------------------------------------------
# Selama tiga variabel di bawah kosong, tombol masuk tidak muncul dan aplikasi
# terbuka tanpa login. Server lokal dalam mode produksi menolak start; di Vercel
# aplikasinya tetap jalan dengan login mati.

# Client ID OAuth dari https://console.cloud.google.com/auth/clients
# (Create client -> Web application). Bukan rahasia: nilainya memang tampil di
# halaman. Client Secret TIDAK dipakai, jangan disimpan di sini.
# Authorized JavaScript origins: http://localhost, http://localhost:5173,
# dan domain produksimu.
GOOGLE_CLIENT_ID=

# Penandatangan cookie sesi. Minimal 32 karakter, acak, rahasia. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Menggantinya mengeluarkan semua orang yang sedang masuk.
SESSION_SECRET=

# --- Penyimpanan pengguna (Supabase) -----------------------------------------
# Project Settings -> API. Ambil yang berlabel service_role, BUKAN anon.
# service_role MELEWATI Row Level Security: server-side saja, jangan pernah
# masuk ke src/. SQL pembuatan tabel ada di komentar atas server/userStore.js.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

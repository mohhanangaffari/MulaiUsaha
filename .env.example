# Setiap variabel di sini benar-benar dibaca kode. Daftarnya dicocokkan dengan
# hasil pencarian `process.env.*` di server/ pada 2026-08-25.

# --- Wajib: tanpa ini fitur intinya mati -------------------------------------

# Konsep usaha dan daftar bahan dari AI (server/aiService.js).
# Tanpa ini: langkah 3 dan 4 tidak menghasilkan apa pun.
GEMINI_API_KEY=

# Google Places + Geocoding: pesaing, detail tempat, pencarian lokasi.
# Aktifkan "Places API (New)" di Google Cloud. Server-side saja.
# Tanpa ini: langkah 2 kosong.
GOOGLE_MAPS_API_KEY=

# Ulasan pesaing dan pencarian toko pemasok lokal (server/serpApiService.js).
# Tanpa ini: tab "Lokal" di langkah 4 tidak menemukan toko.
SERPAPI_API_KEY=

# Menyebut identitas MulaiUsaha ke geocoder publik OpenStreetMap. Isi dengan URL
# atau email kontak. Tanpa ini permintaan bisa dibatasi oleh mereka.
APP_CONTACT_URL=

# --- Opsional ----------------------------------------------------------------

# Kunci SerpApi cadangan. Dipakai bergantian saat kuota kunci utama habis.
SERPAPI_KEY_2=
SERPAPI_KEY_3=
SERPAPI_KEY_4=
SERPAPI_KEY_5=

# Port server lokal. Default 5173. JANGAN diisi di Vercel — platform yang
# menentukannya sendiri, dan mengisinya bisa menggagalkan deploy.
PORT=

# --- Akun & penyimpanan projek (Supabase) ------------------------------------
# Selama SUPABASE_URL, SUPABASE_ANON_KEY, atau SESSION_SECRET kosong, tombol
# masuk tidak muncul dan aplikasi terbuka penuh tanpa akun. Semua yang di bawah
# ini dibaca server saja; frontend tidak pernah menyentuh Supabase.
#
# Sebelum dipakai, dua langkah di dashboard Supabase:
#  1. Authentication -> Providers -> Email -> matikan "Confirm email"
#  2. SQL Editor -> jalankan SQL pembuatan tabel yang ada di komentar atas
#     server/projectStore.js

# Project Settings -> API -> Project URL
SUPABASE_URL=

# Kunci "anon". Dipakai untuk endpoint daftar dan masuk. Memang dirancang untuk
# publik, tapi di aplikasi ini tetap dipegang server.
SUPABASE_ANON_KEY=

# Kunci "service_role". MELEWATI Row Level Security, jadi server-side saja dan
# jangan pernah masuk ke src/. Dipakai hanya untuk tabel projects, dan setiap
# query di server/projectStore.js disaring per user_id dengan tangan.
SUPABASE_SERVICE_ROLE_KEY=

# Penandatangan cookie sesi. Minimal 32 karakter, acak, rahasia. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Menggantinya mengeluarkan semua orang yang sedang masuk.
SESSION_SECRET=
